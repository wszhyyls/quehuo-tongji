{
  "name": "wszh-shortage-store",
  "version": "5.15.11",
  "description": "微山县众和医药连锁有限公司 - 门店缺货上报客户端（本地加载版 · 自动卸载旧版）",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --c.directories.output=dist"
  },
  "build": {
    "appId": "com.wszh.shortage-store",
    "productName": "WSZH-ShortageStore",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "static/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "众和医药缺货订购系统",
      "include": "installer.nsh",
      "runAfterFinish": false
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "static/**/*",
      "!static/**/*.map",
      "!deploy/**/*"
    ],
    "extraResources": [
      {
        "from": "static/",
        "to": "static/",
        "filter": ["**/*"]
      },
      {
        "from": "deploy/",
        "to": "deploy/",
        "filter": [
          "admin.html",
          "login.html",
          "store.html",
          "manifest.json",
          "static/**/*"
        ]
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://wszhyy.pages.dev/releases/"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.1.7",
    "mssql": "^12.7.13",
    "pptxgenjs": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
