# Cloudflare Pages 缓存策略 v2026-11-11
# ★ 每条规则只匹配唯一路径，避免 Cloudflare 叠加重复头

/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/static/js/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/static/css/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/static/manifest.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# ========== autoUpdater 自动更新通道 ==========
# latest.yml 必须 no-store —— 否则客户端永远读到旧清单，认为无新版本
/releases/latest.yml
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# exe / .blockmap 可以长缓存（autoUpdater 靠 Range 分段下载，URL 变则自动换）
/releases/*.exe
  Cache-Control: public, max-age=31536000, immutable

/releases/*.exe.blockmap
  Cache-Control: public, max-age=31536000, immutable
